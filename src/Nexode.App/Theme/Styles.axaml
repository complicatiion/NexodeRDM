<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Nexode.App.Controls"
        xmlns:vm="using:Nexode.App.ViewModels">

  <!-- ===================================================== Base (tokens "B.*" come from ThemeService) -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource B.BgWindow}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource B.SuccessText}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource B.AccentMenu}" />
  </Style>
  <Style Selector="ctl|LineIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================================================== Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource B.Border}" />
  </Style>
  <Style Selector="Border.vdivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource B.Border}" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Border.pill.env" x:DataType="vm:Pill">
    <Setter Property="Background" Value="{Binding Background}" />
  </Style>
  <Style Selector="Border.pill.env TextBlock" x:DataType="vm:Pill">
    <Setter Property="Foreground" Value="{Binding Brush}" />
  </Style>
  <Style Selector="Border.pill.env ctl|LineIcon" x:DataType="vm:Pill">
    <Setter Property="Foreground" Value="{Binding Brush}" />
  </Style>
  <Style Selector="Border.pill.envbadge" x:DataType="vm:TreeRow">
    <Setter Property="Background" Value="{Binding EnvBackground}" />
  </Style>
  <Style Selector="Border.pill.envbadge TextBlock" x:DataType="vm:TreeRow">
    <Setter Property="Foreground" Value="{Binding EnvBrush}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Border.pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Border.pill.accent ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Border.pill.danger">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Border.pill.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Border.pill.danger ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Border.pill.warning">
    <Setter Property="Background" Value="{DynamicResource B.WarningSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="Border.pill.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="Border.pill.warning ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="Border.pill.success">
    <Setter Property="Background" Value="{DynamicResource B.SuccessSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.SuccessText}" />
  </Style>
  <Style Selector="Border.pill.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource B.SuccessText}" />
  </Style>
  <Style Selector="Border.pill.success ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.SuccessText}" />
  </Style>
  <Style Selector="Border.pill.info">
    <Setter Property="Background" Value="{DynamicResource B.InfoSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.InfoText}" />
  </Style>
  <Style Selector="Border.pill.info TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource B.InfoText}" />
  </Style>
  <Style Selector="Border.pill.info ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.InfoText}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource B.WarningSoft}" />
  </Style>
  <Style Selector="Border.notice.danger">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BoxShadow" Value="0 8 28 0 #55000000" />
  </Style>
  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>

  <!-- Accent-tinted vector logo: sharp at every size, follows accent and theme -->
  <Style Selector="Path.logo">
    <Setter Property="Data" Value="{StaticResource logo-mark}" />
    <Setter Property="Fill" Value="{DynamicResource B.AccentGradient}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Path.logofull">
    <Setter Property="Data" Value="{StaticResource logo-full}" />
    <Setter Property="Fill" Value="{DynamicResource B.AccentGradient}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- ===================================================== Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="DropDownButton">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="SplitButton">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource B.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextDisabled}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource B.DangerFill}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.DangerFillHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.broadcast:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="ToggleButton.broadcast:checked ctl|LineIcon">
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="DropDownButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <!-- Icon-only button: glyph only, soft round tint on hover -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="DropDownButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="Button.icon.webbar">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="ToggleButton.icon.small">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="Button.icon.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentHover}" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
  </Style>
  <!-- Color swatch (folder colors, accent presets) -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource B.TextPrimary}" />
  </Style>

  <!-- ===================================================== Menus -->
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource B.AccentMenu}" />
  </Style>
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
  </Style>

  <!-- ===================================================== Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource B.AccentMenu}" />
  </Style>
  <Style Selector="TextBox[AcceptsReturn=True]">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <!-- Command palette -->
  <Style Selector="TextBox.palette">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="Border.palettebox">
    <Setter Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.paletterow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.paletterow.selected">
    <Setter Property="Background" Value="{DynamicResource B.AccentMenu}" />
  </Style>
  <Style Selector="Grid.form > TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,16,10" />
  </Style>
  <Style Selector="Grid.form > TextBox">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > ComboBox">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > NumericUpDown">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > StackPanel">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > Grid">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > CheckBox">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > ToggleSwitch">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.form > WrapPanel">
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Grid.settings > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,16,12" />
  </Style>
  <Style Selector="Grid.settings > ComboBox">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > ToggleSwitch">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > NumericUpDown">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > TextBox">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > StackPanel">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > WrapPanel">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.settings > Button">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================================================== Rail (left icon navigation) -->
  <Style Selector="ListBox.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Button.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
  </Style>

  <!-- ===================================================== Tree -->
  <Style Selector="ListBox.tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBox.tree ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.tree ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="ListBox.tree ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,2,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.row.compact">
    <Setter Property="Height" Value="25" />
  </Style>
  <Style Selector="Border.row.dropBefore">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.row.dropAfter">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.row.dropInto">
    <Setter Property="Background" Value="{DynamicResource B.AccentMenu}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.heart">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextDisabled}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Button.heart">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.heart.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Button.heart.on ctl|LineIcon">
    <Setter Property="Filled" Value="True" />
  </Style>
  <Style Selector="Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
  </Style>

  <!-- ===================================================== Tabs -->
  <Style Selector="Border.tab">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Margin" Value="0,6,2,0" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="Border.tab.selected">
    <Setter Property="Background" Value="{DynamicResource B.AccentTab}" />
  </Style>
  <Style Selector="Border.tab.selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.tabactive">
    <Setter Property="Background" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Border.tab Button.close">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.tab:pointerover Button.close, Border.tab.selected Button.close">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TabControl.pills">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.pills TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="GridSplitter.panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="5" />
  </Style>
  <Style Selector="GridSplitter.panel:pointerover">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>

  <!-- ===================================================== Settings building blocks -->
  <Style Selector="StackPanel.settingspage">
    <Setter Property="Spacing" Value="16" />
    <Setter Property="Margin" Value="0,16,16,30" />
    <Setter Property="MaxWidth" Value="900" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.cardtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="ctl|SettingRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" MinHeight="42">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ctl:LineIcon Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource B.TextSecondary}"
                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Border Background="Transparent" ToolTip.Tip="{TemplateBinding Info}" ToolTip.ShowDelay="150"
                    IsVisible="{TemplateBinding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ctl:LineIcon Icon="info" Size="14" Foreground="{DynamicResource B.AccentText}" />
            </Border>
          </StackPanel>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ctl|SettingRow > ComboBox">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="ctl|SettingRow > NumericUpDown">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="ctl|SettingRow > TextBox">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="ctl|SettingRow > ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="0,0,-10,0" />
  </Style>
  <Style Selector="Border.rowdivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource B.Border}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="ctl|Hint">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
          <Panel Height="17" VerticalAlignment="Top" Margin="0,0,8,0">
            <ctl:LineIcon Icon="info" Size="14" VerticalAlignment="Center" Foreground="{DynamicResource B.AccentText}" />
          </Panel>
          <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" Classes="muted small" TextWrapping="Wrap" LineHeight="17" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ctl|InfoCard">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="notice infocard" Padding="12,9,6,9">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Panel Height="19" VerticalAlignment="Top" Margin="0,0,10,0">
              <ctl:LineIcon x:Name="PART_Icon" Icon="{TemplateBinding Icon}" Size="16" VerticalAlignment="Center" Foreground="{DynamicResource B.AccentText}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" LineHeight="19" TextWrapping="Wrap"
                         IsVisible="{Binding $parent[ctl:InfoCard].Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{TemplateBinding Text}" TextWrapping="Wrap" LineHeight="19" Classes="small"
                         IsVisible="{Binding $parent[ctl:InfoCard].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{Binding $parent[ctl:InfoCard].Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="PART_Close" Classes="icon small" Width="24" Height="24" Margin="6,-3,0,0" VerticalAlignment="Top"
                    IsVisible="{TemplateBinding Dismissible}" ToolTip.Tip="{DynamicResource S.Hint.Close}">
              <ctl:LineIcon Icon="x" Size="14" />
            </Button>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ctl|InfoCard.warning /template/ Border.infocard">
    <Setter Property="Background" Value="{DynamicResource B.WarningSoft}" />
  </Style>
  <Style Selector="ctl|InfoCard.warning /template/ ctl|LineIcon#PART_Icon">
    <Setter Property="Foreground" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="ctl|PathPill">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="pill" Padding="12,0,3,0" Height="30" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
              <SelectableTextBlock Text="{TemplateBinding Text}" Classes="mono" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
            </ScrollViewer>
            <Button Grid.Column="1" x:Name="PART_Copy" Classes="icon small" Width="24" Height="24" ToolTip.Tip="{DynamicResource S.Copy.Path}">
              <ctl:LineIcon Icon="copy" Size="13" />
            </Button>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Status pill in a card's title row (top right): same width and alignment on every card -->
  <Style Selector="Border.headpill">
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.headpill TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Fixed-width status pill -->
  <Style Selector="Border.status">
    <Setter Property="MinWidth" Value="128" />
  </Style>
  <Style Selector="Border.status TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- Category / source cards -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,8,6,8" />
  </Style>
  <!-- Orange-framed notice (disclaimer) -->
  <Style Selector="Border.framed">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.framed.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource B.Warning}" />
    <Setter Property="Background" Value="{DynamicResource B.WarningSoft}" />
  </Style>
  <!-- Heart toggle button (editor, details) -->
  <Style Selector="ToggleButton.heart">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.heart:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="ToggleButton.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="ToggleButton.heart:checked ctl|LineIcon">
    <Setter Property="Filled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <!-- Pinned rail items -->
  <Style Selector="Border.railpin">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.railpin:pointerover">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="Border.railpin.dropBefore">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.raildrop">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>

  <!-- ===================================================== Sessions -->
  <Style Selector="Border.sessionbar">
    <Setter Property="Background" Value="{DynamicResource B.BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,4,8,4" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="Ellipse.statedot">
    <Setter Property="Fill" Value="{DynamicResource B.WarningText}" />
  </Style>
  <Style Selector="Ellipse.statedot.on">
    <Setter Property="Fill" Value="{DynamicResource B.SuccessText}" />
  </Style>
  <Style Selector="Ellipse.statedot.off">
    <Setter Property="Fill" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Start page tiles (favorites, profiles, new): same width, same hover -->
  <Style Selector="Button.tilebtn">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tilebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tilebtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.tilecard">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
  </Style>
  <Style Selector="Button.tilebtn:pointerover Border.tilecard">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="Button.tilebtn:pressed Border.tilecard">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <!-- Top bar and tree bar icon buttons -->
  <Style Selector="Button.icon.topbar">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>
  <Style Selector="Button.icon.treebar">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="Button.icon.accenticon">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Button.icon.accenticon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="Button.icon.topbar.on">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <!-- Tab close: grey, red on hover -->
  <Style Selector="Border.tab Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <!-- Segmented toggle (recent / most used) -->
  <Style Selector="ToggleButton.seg">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <!-- Connection profile cards in the side panel -->
  <Style Selector="Border.profile">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,7,4,7" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.profile:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceHover}" />
  </Style>
  <Style Selector="Border.profileicon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.profileicon ctl|LineIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Split view panes -->
  <Style Selector="Border.logbox">
    <Setter Property="Background" Value="{DynamicResource B.BgContent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.row.featureoff">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.pane">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.pane.active">
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentText}" />
  </Style>
  <!-- "Send input to all terminals": every receiving pane gets a red frame -->
  <Style Selector="Border.pane.broadcast">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}" />
  </Style>
  <Style Selector="Border.paneheader">
    <Setter Property="Background" Value="{DynamicResource B.BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.paneheader Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.DangerText}" />
  </Style>
  <Style Selector="ListBox.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0,4,4" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <!-- Session overlay: round icon badge above the centered title -->
  <Style Selector="Border.overlayicon">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
  </Style>
  <Style Selector="Border.overlayicon.warn">
    <Setter Property="Background" Value="{DynamicResource B.WarningSoft}" />
  </Style>

  <!-- File browser: column headers, toolbar, thin pane divider -->
  <Style Selector="Button.colhead">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Button.colhead.sorted">
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="GridSplitter.thin">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="MinHeight" Value="9" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Background="{DynamicResource B.Border}" Width="1" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.thin.horizontal">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Background="{DynamicResource B.Border}" Height="1" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.thin:pointerover /template/ Border > Border">
    <Setter Property="Background" Value="{DynamicResource B.AccentText}" />
  </Style>
  <!-- Live status dot on the entry icon (tree) -->
  <Style Selector="Ellipse.livedot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-3,-1" />
    <Setter Property="Stroke" Value="{DynamicResource B.BgPanel}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Ellipse.livedot.on">
    <Setter Property="Fill" Value="{DynamicResource B.Success}" />
  </Style>
  <Style Selector="Ellipse.livedot.off">
    <Setter Property="Fill" Value="{DynamicResource B.Danger}" />
  </Style>
  <!-- Kiosk exit button: almost invisible until the pointer is near -->
  <Style Selector="Button.kioskexit">
    <Setter Property="Opacity" Value="0.18" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.kioskexit:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Fixed width buttons in settings rows (same width as dropdowns) -->
  <Style Selector="Button.w220, DropDownButton.w220">
    <Setter Property="Width" Value="220" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Keyboard shortcut pills -->
  <Style Selector="Border.keypill">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <Style Selector="Border.keypill TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.shortcut">
    <Setter Property="Margin" Value="0,1" />
  </Style>
</Styles>
