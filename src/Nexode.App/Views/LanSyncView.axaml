<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexode.App.ViewModels"
             xmlns:ctl="using:Nexode.App.Controls"
             x:Class="Nexode.App.Views.LanSyncView"
             x:DataType="vm:LanSyncTabViewModel">
  <ScrollViewer>
    <StackPanel Margin="36,28,36,28" MaxWidth="1000" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" Classes="h1" />
          <TextBlock Text="{DynamicResource S.LanSync.Subtitle}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="pill" Classes.success="{Binding IsListening}" VerticalAlignment="Top">
          <ctl:IconLabel Icon="radio" Text="{Binding StatusText}" />
        </Border>
      </Grid>

      <ctl:InfoCard Classes="warning" Icon="lock" FollowHints="False" Dismissible="False" Text="{Binding BlockedText}" IsVisible="{Binding IsBlocked}" />

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="cardtitle" Text="{DynamicResource S.LanSync.ThisComputer}" />
          <ctl:SettingRow Label="{DynamicResource S.LanSync.Source}" Icon="database">
            <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center" />
          </ctl:SettingRow>
          <ctl:SettingRow Label="{DynamicResource S.LanSync.DeviceName}" Icon="monitor" Info="{DynamicResource S.LanSync.DeviceNameInfo}">
            <TextBox Text="{Binding DeviceName}" Classes="w220" IsEnabled="{Binding IsNotListening}" />
          </ctl:SettingRow>
          <ctl:SettingRow Label="{DynamicResource S.LanSync.Password}" Icon="key-round" Info="{DynamicResource S.LanSync.PasswordInfo}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBox Text="{Binding Password}" Classes="w220 mono" PasswordChar="•" RevealPassword="{Binding ShowPassword}" IsEnabled="{Binding IsNotListening}" />
              <ToggleButton Classes="icon" IsChecked="{Binding ShowPassword}" ToolTip.Tip="{DynamicResource S.Entry.Reveal}">
                <ctl:LineIcon Icon="eye" Size="15" />
              </ToggleButton>
              <Button Classes="icon" Command="{Binding NewPasswordCommand}" IsEnabled="{Binding IsNotListening}" ToolTip.Tip="{DynamicResource S.FtpServer.NewPassword}">
                <ctl:LineIcon Icon="refresh-cw" Size="15" />
              </Button>
              <Button Classes="icon" Command="{Binding CopyCommand}" CommandParameter="{Binding Password}" IsEnabled="{Binding HasPassword}" ToolTip.Tip="{DynamicResource S.FtpServer.CopyPassword}">
                <ctl:LineIcon Icon="copy" Size="15" />
              </Button>
            </StackPanel>
          </ctl:SettingRow>
          <ctl:SettingRow Label="{DynamicResource S.LanSync.Port}" Icon="hash" Info="{DynamicResource S.LanSync.PortInfo}">
            <TextBox Text="{Binding Port}" Classes="w220 mono" IsEnabled="{Binding IsNotListening}" />
          </ctl:SettingRow>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Classes="w220 danger" Command="{Binding StopListeningCommand}" IsVisible="{Binding IsListening}">
              <ctl:IconLabel Icon="square" Text="{DynamicResource S.LanSync.StopListening}" />
            </Button>
            <Button Classes="w220 primary" Command="{Binding StartListeningCommand}" IsVisible="{Binding IsNotListening}" IsEnabled="{Binding CanSync}">
              <ctl:IconLabel Icon="radio" Text="{DynamicResource S.LanSync.StartListening}" />
            </Button>
          </StackPanel>
          <ctl:Hint Text="{DynamicResource S.LanSync.ListenHint}" Always="True" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardtitle" Text="{DynamicResource S.LanSync.SyncWith}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding SearchCommand}" IsEnabled="{Binding IsIdle}">
              <ctl:IconLabel Icon="search" Text="{DynamicResource S.LanSync.Search}" />
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsIdle}">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" MinHeight="4" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource S.LanSync.Working}" Classes="muted" VerticalAlignment="Center" />
            <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsSyncing}">
              <ctl:IconLabel Icon="x" Text="{DynamicResource S.Cancel}" />
            </Button>
          </StackPanel>
          <TextBlock Text="{DynamicResource S.LanSync.NoPeers}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasPeers}" />
          <ItemsControl ItemsSource="{Binding Peers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LanPeerRow">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                  <ctl:LineIcon Icon="{Binding Icon}" Size="16" Margin="0,0,12,0" Foreground="{DynamicResource B.TextSecondary}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" Classes="muted small mono" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon" Margin="0,0,6,0" IsVisible="{Binding IsKnown}" ToolTip.Tip="{DynamicResource S.LanSync.Forget}"
                          Command="{Binding $parent[UserControl].((vm:LanSyncTabViewModel)DataContext).ForgetPeerCommand}" CommandParameter="{Binding}">
                    <ctl:LineIcon Icon="trash-2" Size="15" />
                  </Button>
                  <Button Grid.Column="3" Classes="primary" IsEnabled="{Binding $parent[UserControl].((vm:LanSyncTabViewModel)DataContext).IsIdle}"
                          Command="{Binding $parent[UserControl].((vm:LanSyncTabViewModel)DataContext).SyncPeerCommand}" CommandParameter="{Binding}">
                    <ctl:IconLabel Icon="refresh-cw" Text="{DynamicResource S.LanSync.SyncNow}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ctl:SettingRow Label="{DynamicResource S.LanSync.Manual}" Icon="network" Info="{DynamicResource S.LanSync.ManualInfo}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding ManualAddress}" Classes="w220 mono" Watermark="192.0.2.20:47810" />
              <Button Command="{Binding SyncManualCommand}" IsEnabled="{Binding IsIdle}">
                <ctl:IconLabel Icon="refresh-cw" Text="{DynamicResource S.LanSync.SyncNow}" />
              </Button>
            </StackPanel>
          </ctl:SettingRow>
          <Border Classes="notice" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource B.DangerText}" />
          </Border>
          <Border Classes="notice" IsVisible="{Binding HasResult}">
            <ctl:IconLabel Icon="check" Text="{Binding Result}" />
          </Border>
          <ctl:Hint Text="{DynamicResource S.LanSync.HowItWorks}" Always="True" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardtitle" Text="{DynamicResource S.LanSync.Activity}" />
          <TextBlock Text="{DynamicResource S.FtpServer.NoActivity}" Classes="muted" IsVisible="{Binding !HasEvents}" />
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LanEventRow">
                <Grid ColumnDefinitions="Auto,80,*" Margin="0,2">
                  <ctl:LineIcon Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.AccentText}" Classes.danger="{Binding IsWarning}" />
                  <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="small muted mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
