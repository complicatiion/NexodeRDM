<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexode.App.ViewModels"
             xmlns:ctl="using:Nexode.App.Controls"
             xmlns:model="using:Nexode.Core.Model"
             xmlns:v="using:Nexode.App.Views"
             x:Class="Nexode.App.Views.EntryView"
             x:DataType="vm:EntryTabViewModel">
  <UserControl.Styles>
    <Style Selector="ProgressBar.disk">
      <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
      <Setter Property="Background" Value="{DynamicResource B.SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ProgressBar.disk.danger">
      <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel MaxWidth="1040" Margin="36,28,36,36" Spacing="18">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource B.AccentSoft}" Margin="0,0,16,0" VerticalAlignment="Top">
          <ctl:LineIcon Icon="{Binding Icon}" Size="26" HorizontalAlignment="Center" Foreground="{DynamicResource B.AccentText}" Tint="{Binding IconBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="{Binding Title}" Classes="h1" TextTrimming="CharacterEllipsis" />
          <Button Classes="link" Command="{Binding RevealInTreeCommand}" HorizontalAlignment="Left" ToolTip.Tip="{DynamicResource S.Entry.RevealInTree}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:LineIcon Icon="folder-tree" Size="13" />
              <TextBlock Text="{Binding PathText}" FontSize="12" />
            </StackPanel>
          </Button>
          <ItemsControl ItemsSource="{Binding Pills}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:Pill">
                <Border Classes="pill" Classes.accent="{Binding Class, Converter={x:Static v:Converters.Equal}, ConverterParameter=accent}"
                        Classes.danger="{Binding Class, Converter={x:Static v:Converters.Equal}, ConverterParameter=danger}"
                        Classes.warning="{Binding Class, Converter={x:Static v:Converters.Equal}, ConverterParameter=warning}"
                        Classes.info="{Binding Class, Converter={x:Static v:Converters.Equal}, ConverterParameter=info}"
                        Classes.success="{Binding Class, Converter={x:Static v:Converters.Equal}, ConverterParameter=success}"
                        Classes.env="{Binding Brush, Converter={x:Static v:Converters.NotNull}}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <ctl:LineIcon Icon="{Binding Icon}" Size="12" IsVisible="{Binding Icon, Converter={x:Static v:Converters.NotNull}}" />
                    <TextBlock Text="{Binding Text}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <ToggleButton Classes="heart" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{DynamicResource S.Menu.Favorite}">
            <ctl:LineIcon Icon="heart" Size="18" />
          </ToggleButton>
          <Button Command="{Binding EditCommand}">
            <ctl:IconLabel Icon="pencil" Text="{DynamicResource S.Menu.Edit}" />
          </Button>
          <Button Command="{Binding ConnectExternalCommand}" IsVisible="{Binding IsConnection}">
            <ctl:IconLabel Icon="external-link" Text="{DynamicResource S.Menu.OpenExternal}" />
          </Button>
          <Button Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding IsWeb}">
            <ctl:IconLabel Icon="external-link" Text="{DynamicResource S.Menu.OpenBrowser}" />
          </Button>
          <Button Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding IsConnection}">
            <ctl:IconLabel Icon="plug-zap" Text="{DynamicResource S.Session.Connect}" />
          </Button>
        </StackPanel>
      </Grid>

      <Border Classes="notice warning" IsVisible="{Binding NeedsReview}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ctl:LineIcon Icon="triangle-alert" Size="18" Margin="0,0,12,0" Foreground="{DynamicResource B.WarningText}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource S.Entry.ReviewText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Margin="12,0,0,0" Command="{Binding ApproveCommand}">
            <ctl:IconLabel Icon="badge-check" Text="{DynamicResource S.Menu.Approve}" />
          </Button>
        </Grid>
      </Border>

      <TextBlock Text="{Binding Entry.Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" Classes="muted" />

      <Grid ColumnDefinitions="*,18,*">
        <!-- Connection -->
        <Border Classes="card" IsVisible="{Binding HasConnectionRows}">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource S.Entry.Connection}" Classes="section" />
            <ItemsControl ItemsSource="{Binding ConnectionRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:InfoRow">
                  <Grid ColumnDefinitions="Auto,120,*,Auto" Margin="0,3">
                    <ctl:LineIcon Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding Value}" Classes.mono="{Binding Mono}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Source}" Classes="muted small" IsVisible="{Binding HasSource}" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="icon small" IsVisible="{Binding HasCopy}" ToolTip.Tip="{DynamicResource S.Menu.Copy}"
                            Command="{Binding $parent[UserControl].((vm:EntryTabViewModel)DataContext).CopyCommand}" CommandParameter="{Binding Copy}">
                      <ctl:LineIcon Icon="copy" Size="14" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Credentials -->
        <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasCredentials}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource S.Entry.Credentials}" Classes="section" />
              <Border Grid.Column="1" Classes="pill" IsVisible="{Binding HasCredentialSource}">
                <TextBlock Text="{Binding CredentialSource}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding CredentialRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:InfoRow">
                  <Grid ColumnDefinitions="Auto,120,*,Auto" Margin="0,3">
                    <ctl:LineIcon Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" Classes="mono" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="3" Classes="icon small" IsVisible="{Binding HasCopy}" ToolTip.Tip="{DynamicResource S.Menu.Copy}"
                            Command="{Binding $parent[UserControl].((vm:EntryTabViewModel)DataContext).CopyCommand}" CommandParameter="{Binding Copy}">
                      <ctl:LineIcon Icon="copy" Size="14" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,120,*,Auto,Auto" IsVisible="{Binding HasPassword}" Margin="0,3">
              <ctl:LineIcon Icon="key-round" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{DynamicResource S.Field.Password}" Classes="muted" VerticalAlignment="Center" />
              <SelectableTextBlock Grid.Column="2" Text="{Binding PasswordText}" Classes="mono" VerticalAlignment="Center" />
              <Button Grid.Column="3" Classes="icon small" Command="{Binding RevealPasswordCommand}" ToolTip.Tip="{DynamicResource S.Entry.Reveal}">
                <ctl:LineIcon Icon="eye" Size="14" />
              </Button>
              <Button Grid.Column="4" Classes="icon small" Command="{Binding CopyPasswordCommand}" ToolTip.Tip="{DynamicResource S.Copy.Password}">
                <ctl:LineIcon Icon="copy" Size="14" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- System information (feature "sysinfo") -->
      <Border Classes="card" IsVisible="{Binding CanSysInfo}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource S.SysInfo.Title}" Classes="section" />
              <TextBlock Text="{Binding SysInfoStatus}" Classes="muted small" IsVisible="{Binding HasSysInfo}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="icon" Command="{Binding ClearSysInfoCommand}" IsVisible="{Binding HasSysInfo}" ToolTip.Tip="{DynamicResource S.SysInfo.Clear}">
                <ctl:LineIcon Icon="eraser" Size="14" />
              </Button>
              <Button Command="{Binding CancelSysInfoCommand}" IsVisible="{Binding IsFetchingSysInfo}">
                <ctl:IconLabel Icon="x" Text="{DynamicResource S.Cancel}" />
              </Button>
              <Button Command="{Binding FetchSysInfoCommand}" IsVisible="{Binding !IsFetchingSysInfo}">
                <ctl:IconLabel Icon="refresh-cw" Text="{DynamicResource S.SysInfo.Fetch}" />
              </Button>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsFetchingSysInfo}">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" MinHeight="4" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource S.SysInfo.Fetching}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{DynamicResource S.SysInfo.Hint}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSysInfoHint}" />
          <ctl:InfoCard Classes="warning" Icon="circle-alert" FollowHints="False" Dismissible="False" Text="{Binding SysInfoError}" IsVisible="{Binding HasSysInfoError}" />
          <ItemsControl ItemsSource="{Binding SysInfoRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:InfoRow">
                <Grid ColumnDefinitions="Auto,120,*" Margin="0,3">
                  <ctl:LineIcon Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="6" IsVisible="{Binding HasSysInfoDisks}">
            <TextBlock Text="{DynamicResource S.SysInfo.Disks}" Classes="muted small" />
            <ItemsControl ItemsSource="{Binding SysInfoDisks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DiskRow">
                  <Grid ColumnDefinitions="Auto,180,180,*" Margin="0,3">
                    <ctl:LineIcon Icon="hard-drive" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <ProgressBar Grid.Column="2" Value="{Binding Fraction}" Maximum="1" Height="6" MinHeight="6" VerticalAlignment="Center" Classes="disk" Classes.danger="{Binding IsHigh}" />
                    <TextBlock Grid.Column="3" Text="{Binding Text}" Classes="muted small" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Children of folders and hosts -->
      <Border Classes="card" IsVisible="{Binding IsContainer}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource S.Entry.Contents}" Classes="section" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Command="{Binding AddChildCommand}" CommandParameter="{x:Static model:EntryKind.Folder}">
                <ctl:IconLabel Icon="folder-plus" Text="{DynamicResource S.Kind.Folder}" />
              </Button>
              <Button Command="{Binding AddChildCommand}" CommandParameter="{x:Static model:EntryKind.Rdp}">
                <ctl:IconLabel Icon="monitor" Text="{DynamicResource S.Kind.Rdp}" />
              </Button>
              <Button Command="{Binding AddChildCommand}" CommandParameter="{x:Static model:EntryKind.Ssh}">
                <ctl:IconLabel Icon="square-terminal" Text="{DynamicResource S.Kind.Ssh}" />
              </Button>
              <Button Command="{Binding AddChildCommand}" CommandParameter="{x:Static model:EntryKind.Web}">
                <ctl:IconLabel Icon="globe" Text="{DynamicResource S.Kind.Web}" />
              </Button>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Children}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ChildRow">
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                        Command="{Binding $parent[UserControl].((vm:EntryTabViewModel)DataContext).OpenChildCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <ctl:LineIcon Icon="{Binding Icon}" Size="16" Margin="0,0,12,0" Foreground="{DynamicResource B.TextSecondary}" Tint="{Binding IconBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Detail}" Classes="muted small" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding KindText}" Classes="muted small" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{DynamicResource S.Entry.NoChildren}" Classes="muted" IsVisible="{Binding !HasChildren}" />
        </StackPanel>
      </Border>

      <!-- Notes -->
      <Border Classes="card" IsVisible="{Binding HasNotes}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource S.Entry.Notes}" Classes="section" />
          <SelectableTextBlock Text="{Binding Entry.Notes}" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
      </Border>

      <!-- Info -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource S.Entry.Info}" Classes="section" />
          <ItemsControl ItemsSource="{Binding InfoRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:InfoRow">
                <Grid ColumnDefinitions="Auto,120,*" Margin="0,3">
                  <ctl:LineIcon Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" Classes.mono="{Binding Mono}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
