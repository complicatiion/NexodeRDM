<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Nexode.App.ViewModels.Sessions"
             xmlns:ss="using:Nexode.App.Views.Sessions"
             xmlns:ctl="using:Nexode.App.Controls"
             x:Class="Nexode.App.Views.Sessions.WebSessionView"
             x:DataType="s:WebTabViewModel">
  <DockPanel>
    <!-- Browser toolbar: back, forward, reload, address, zoom, open in the default browser -->
    <Border DockPanel.Dock="Top" Classes="sessionbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsEnabled="{Binding IsConnected}">
          <Button Classes="icon webbar" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{DynamicResource S.Web.Back}"><ctl:LineIcon Icon="arrow-left" Size="19" /></Button>
          <Button Classes="icon webbar" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{DynamicResource S.Web.Forward}"><ctl:LineIcon Icon="arrow-right" Size="19" /></Button>
          <Button Classes="icon webbar" Command="{Binding ReloadPageCommand}" ToolTip.Tip="{DynamicResource S.Web.Reload}">
            <Panel>
              <ctl:LineIcon Icon="rotate-cw" Size="19" IsVisible="{Binding !IsLoading}" />
              <ctl:LineIcon Icon="x" Size="19" IsVisible="{Binding IsLoading}" />
            </Panel>
          </Button>
          <Button Classes="icon webbar" Command="{Binding HomeCommand}" ToolTip.Tip="{DynamicResource S.Web.Home}"><ctl:LineIcon Icon="house" Size="19" /></Button>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="8,0" VerticalAlignment="Center">
          <TextBox x:Name="AddressBox" Text="{Binding Address}" Classes="mono" FontSize="12" MinHeight="28" IsEnabled="{Binding IsConnected}">
            <TextBox.InnerLeftContent>
              <Panel Margin="8,0,2,0" VerticalAlignment="Center">
                <ctl:LineIcon Icon="globe-lock" Size="14" Foreground="{DynamicResource B.TextSecondary}" IsVisible="{Binding !IgnoreCertificates}" />
                <ctl:LineIcon Icon="shield-alert" Size="14" Foreground="{DynamicResource B.WarningText}" IsVisible="{Binding IgnoreCertificates}" />
              </Panel>
            </TextBox.InnerLeftContent>
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding GoCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Border Grid.Column="1" Classes="pill warning" Margin="6,0,0,0" IsVisible="{Binding IgnoreCertificates}" ToolTip.Tip="{DynamicResource S.Web.CertOffTip}">
            <ctl:IconLabel Icon="shield-alert" Text="{DynamicResource S.Web.CertOff}" />
          </Border>
          <Border Grid.Column="2" Classes="pill accent" Margin="6,0,0,0" IsVisible="{Binding HasTunnel}" ToolTip.Tip="{Binding TunnelText}">
            <ctl:IconLabel Icon="waypoints" Text="{DynamicResource S.Tunnel.Badge}" />
          </Border>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2" IsEnabled="{Binding IsConnected}">
            <Button Classes="icon webbar" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{DynamicResource S.Web.ZoomOut}"><ctl:LineIcon Icon="zoom-out" Size="19" /></Button>
            <Button Classes="ghost small" Command="{Binding ZoomResetCommand}" MinWidth="52" ToolTip.Tip="{DynamicResource S.Web.ZoomReset}">
              <TextBlock Text="{Binding ZoomText}" FontSize="11.5" HorizontalAlignment="Center" />
            </Button>
            <Button Classes="icon webbar" Command="{Binding ZoomInCommand}" ToolTip.Tip="{DynamicResource S.Web.ZoomIn}"><ctl:LineIcon Icon="zoom-in" Size="19" /></Button>
          </StackPanel>
          <Border Classes="vdivider" Margin="6,4" />
          <Button Classes="icon webbar" Command="{Binding OpenExternalCommand}" ToolTip.Tip="{DynamicResource S.Web.OpenExternal}"><ctl:LineIcon Icon="external-link" Size="19" /></Button>
          <Button Classes="icon webbar danger" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" ToolTip.Tip="{DynamicResource S.Web.ClosePage}"><ctl:LineIcon Icon="unplug" Size="19" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice danger" Margin="10,8,10,0" IsVisible="{Binding HasPageError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:LineIcon Icon="circle-alert" Size="16" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding PageError}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="ghost small" Command="{Binding OpenExternalCommand}">
          <ctl:IconLabel Icon="external-link" Text="{DynamicResource S.Web.OpenExternal}" />
        </Button>
      </Grid>
    </Border>
    <Panel>
      <Panel x:Name="Host" />
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />
      <!-- Own window: placeholder in the tab -->
      <Border Classes="card overlay" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560" Padding="28,24" x:Name="DialogCard" IsVisible="False">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Border Classes="overlayicon" HorizontalAlignment="Center">
            <ctl:LineIcon Icon="app-window" Size="26" Foreground="{DynamicResource B.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{DynamicResource S.Web.InWindow}" Classes="h3" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource S.Web.InWindowText}" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Command="{Binding OpenExternalCommand}"><ctl:IconLabel Icon="external-link" Text="{DynamicResource S.Web.OpenExternal}" /></Button>
            <Button Classes="primary" Click="ShowWindowClick"><ctl:IconLabel Icon="app-window" Text="{DynamicResource S.Web.ShowWindow}" /></Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <ss:SessionOverlay />
    </Panel>
  </DockPanel>
</UserControl>
