<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Nexode.App.ViewModels.Sessions"
             xmlns:ss="using:Nexode.App.Views.Sessions"
             xmlns:ctl="using:Nexode.App.Controls"
             x:Class="Nexode.App.Views.Sessions.VncSessionView"
             x:DataType="s:VncTabViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="sessionbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Classes="statedot" Classes.on="{Binding IsConnected}" Classes.off="{Binding IsEnded}" />
          <TextBlock Text="{Binding StatusText}" Classes="small" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DesktopText}" Classes="small muted" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
          <Button Classes="ghost small" Command="{Binding SendCtrlAltDelCommand}" IsEnabled="{Binding IsConnected}">
            <ctl:IconLabel Icon="keyboard" Text="Ctrl+Alt+Del" />
          </Button>
          <Button Classes="icon small" Click="SendClipboard" ToolTip.Tip="{DynamicResource S.Vnc.SendClipboard}" IsEnabled="{Binding IsConnected}"><ctl:LineIcon Icon="clipboard-paste" Size="17" /></Button>
          <ToggleButton Classes="icon small" IsChecked="{Binding Scale}" ToolTip.Tip="{DynamicResource S.Vnc.Scale}"><ctl:LineIcon Icon="scaling" Size="15" /></ToggleButton>
          <ToggleButton Classes="icon small" IsChecked="{Binding ViewOnly}" ToolTip.Tip="{DynamicResource S.Vnc.ViewOnly}"><ctl:LineIcon Icon="eye" Size="15" /></ToggleButton>
          <Border Classes="vdivider" Margin="6,4" />
          <Button Classes="icon small" Command="{Binding FullscreenCommand}" ToolTip.Tip="{DynamicResource S.Session.Fullscreen}"><ctl:LineIcon Icon="maximize" Size="17" /></Button>
          <Button Classes="icon small" Command="{Binding ReconnectCommand}" ToolTip.Tip="{DynamicResource S.Session.Reconnect}"><ctl:LineIcon Icon="refresh-cw" Size="17" /></Button>
          <Button Classes="icon small danger" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" ToolTip.Tip="{DynamicResource S.Session.Disconnect}"><ctl:LineIcon Icon="unplug" Size="17" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Panel>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black">
        <ctl:VncView x:Name="Screen" ScaleToFit="{Binding Scale}" />
      </ScrollViewer>
      <ss:SessionOverlay />
    </Panel>
  </DockPanel>
</UserControl>
