<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexode.App.ViewModels"
             xmlns:ctl="using:Nexode.App.Controls"
             x:Class="Nexode.App.Views.AboutView"
             x:DataType="vm:AboutTabViewModel">
  <ScrollViewer>
    <StackPanel Classes="settingspage" Spacing="20">
      <Grid ColumnDefinitions="Auto,*">
        <Path Classes="logofull" Width="92" Height="92" Margin="0,0,24,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Product}" FontSize="30" FontWeight="Bold" />
          <TextBlock Text="{Binding Version}" Classes="accent" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource S.About.Project}" Classes="cardtitle" />
          <StackPanel Spacing="2">
            <TextBlock Text="{DynamicResource S.About.Tagline}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource S.About.Author}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding OpenRepositoryCommand}">
              <ctl:IconLabel Icon="git-branch" Text="{DynamicResource S.About.Repository}" />
            </Button>
            <Button Command="{Binding OpenWebsiteCommand}">
              <ctl:IconLabel Icon="globe" Text="sksdesign.de" />
            </Button>
          </StackPanel>
          <TextBlock Text="{DynamicResource S.About.License}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Disclaimer -->
      <ctl:InfoCard Classes="warning" HintId="about.disclaimer" Icon="triangle-alert"
                    Title="{DynamicResource S.About.DisclaimerTitle}" Text="{DynamicResource S.About.Disclaimer}" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource S.About.System}" Classes="cardtitle" />
          <SelectableTextBlock Text="{Binding Runtime}" Classes="mono small" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <ctl:PathPill Text="{Binding DataPath}" Margin="0,0,10,0" />
            <Button Grid.Column="1" Command="{Binding OpenDataFolderCommand}">
              <ctl:IconLabel Icon="folder-open" Text="{DynamicResource S.Settings.OpenDataFolder}" />
            </Button>
          </Grid>
          <Border Classes="pill" IsVisible="{Binding IsPortable}" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource S.Status.Portable}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource S.About.Licenses}" Classes="cardtitle" />
          <ItemsControl ItemsSource="{Binding Licenses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LicenseItem">
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5"
                        Command="{Binding $parent[UserControl].((vm:AboutTabViewModel)DataContext).OpenLicenseCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <ctl:LineIcon Icon="file-key" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource B.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" Text="{Binding License}" Classes="muted small" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ctl:Hint Text="{DynamicResource S.About.Trademarks}" Always="True" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
